# Copy this file to .env and fill in your own values.
#
#   cp .env.example .env
#
# .env is gitignored and must never be committed. This file holds placeholders
# only, so it is safe to track.


# --- Required to run the agent ---------------------------------------------
#
# The agent makes live model calls, so this is required no matter which
# trigger (Slack or Jira/Confluence) you're using.
OPENAI_API_KEY=sk-proj-replace-me


# --- Slack bot (slack_bot.py) -----------------------------------------------
#
# Socket Mode: no public URL needed. Both tokens come from api.slack.com/apps
# for the app you create. Bot scopes needed: app_mentions:read, chat:write,
# im:history, channels:history (add groups:history too for private
# channels - needed so a short/empty @mention reply can read its thread's
# parent message). For DMs to work at all, also turn on the Messages Tab
# under App Home - Slack drops DMs silently otherwise, before this script
# ever sees them.
SLACK_BOT_TOKEN=xoxb-replace-me
SLACK_APP_TOKEN=xapp-replace-me


# --- Jira + Confluence webhook (jira_webhook.py) ----------------------------
#
# ATLASSIAN_EMAIL / ATLASSIAN_API_TOKEN come from id.atlassian.com -> Account
# Settings -> Security -> API tokens (basic auth: email + token, same for
# both Jira and Confluence REST APIs). ATLASSIAN_SITE_URL is your Jira Cloud
# site, e.g. https://your-site.atlassian.net. ATLASSIAN_WEBHOOK_SECRET is any
# random string you choose; both Automation rules' (Jira and Confluence)
# "Send web request" actions must send it back as an X-Webhook-Secret
# header, which is this endpoint's only auth check (it's a public URL,
# since Atlassian Cloud has to reach it from the outside - see ngrok, or
# similar, for a local demo).
ATLASSIAN_EMAIL=you@example.com
ATLASSIAN_API_TOKEN=replace-me
ATLASSIAN_SITE_URL=https://your-site.atlassian.net
ATLASSIAN_WEBHOOK_SECRET=replace-me
